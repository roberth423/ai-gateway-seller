# ---- Server ----
PORT=5050
# SQLite file location. On Railway mount a volume here.
DATABASE_PATH=/data/app.db

# ---- Admin seed (first boot only) ----
ADMIN_PASSWORD=change-me-now

# ---- Pricing ----
# Cost per token charged to users. Default $2 per 1M tokens.
PRICE_PER_TOKEN=0.000002

# ---- Providers (seeded on first boot) ----
# OpenRouter
OPENROUTER_API_KEY=sk-or-v1-xxxxx

# 9Router
NINE_ROUTER_API_KEY=
NINE_ROUTER_BASE_URL=https://api.9router.com/v1
NINE_ROUTER_MODELS=9router/default

# TokenHarbor
TOKENHARBOR_API_KEY=
TOKENHARBOR_BASE_URL=https://api.tokenharbor.com/v1
TOKENHARBOR_MODELS=tokenharbor/default

# Custom manual provider
CUSTOM_PROVIDER_NAME=MyProvider
CUSTOM_PROVIDER_API_KEY=
CUSTOM_PROVIDER_BASE_URL=https://my-provider.example.com/v1
CUSTOM_PROVIDER_MODELS=custom/model-a,custom/model-b
